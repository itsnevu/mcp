[Unit]
Description=Bugglo — agentic AI for Robinhood Chain
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bugglo
WorkingDirectory=/srv/bugglo
EnvironmentFile=/srv/bugglo/.env.local
Environment=NODE_ENV=production

# Port 3100, NOT 3000 — SpacetimeDB already owns 3000 on this box.
#
# ONE process. Not a cluster.
#
# The spend guard in lib/rateLimit.js keeps its counters in this process's memory, so the
# caps are per-process by construction: run four workers and ENGINE_GLOBAL_USD_PER_DAY=5
# quietly becomes a $20/day ceiling — the exact bill the cap exists to prevent. Move the
# guard to Redis BEFORE ever adding a second worker.
# -H 127.0.0.1: Caddy is the only thing that should ever reach this port. Binding the wildcard
# also makes X-Forwarded-For meaningful only by firewall policy — and lib/rateLimit.js counts
# hops from the right precisely because a client-supplied header is worthless. Bind loopback and
# the trust boundary is enforced by the kernel instead of by a firewall rule nobody re-checks.
ExecStart=/usr/bin/npm run start -- -p 3100 -H 127.0.0.1

# The agent spawns MCP servers (robinx-mcp, boo-crypto, dexscreener) as child processes.
# control-group reaping stops a restart from orphaning them holding stdio pipes.
KillMode=control-group
Restart=always
RestartSec=5

# Those MCP children are third-party npm code, fetched at runtime. Keep them away from the
# rest of the box — the Mythreach game servers and SpacetimeDB live here too.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
RestrictRealtime=true

# NOT ProtectHome=true. Two of the three MCP children execute out of the npx cache in the
# app user's home — `node /home/bugglo/.npm/_npx/<hash>/node_modules/.bin/boo-crypto-mcp` and
# the dexscreener server likewise. Masking /home outright deletes those binaries from the
# service's view, so boo-crypto and dexscreener die on the next restart and the tool count
# silently drops. tmpfs hides every other home on this box (the game servers run here too)
# while BindPaths keeps the one directory npx actually needs, writable — npm takes a lock in
# _cacache on every exec, so read-only is not enough either.
ProtectHome=tmpfs
BindPaths=/home/bugglo/.npm
BindPaths=/home/bugglo/.config

# HARD RESOURCE CEILINGS. This box also runs SpacetimeDB, a WILDER auth server and three
# Mythreach game servers. Without these, a leaking or hostile MCP child is not a Bugglo outage —
# it is an everything-on-this-host outage, because the OOM killer picks its victim by memory
# footprint and has no idea which service anyone cares about.
#
# MemoryMax kills this cgroup instead of letting the kernel choose. TasksMax is the fork-bomb
# stop: the agent spawns npx children that npm-install third-party code at runtime, so the
# process count is not something this repo fully controls. CPUQuota leaves headroom for the
# game servers' tick loops, which notice scheduler starvation long before a web app does.
MemoryMax=1500M
MemoryHigh=1200M
TasksMax=256
CPUQuota=150%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bugglo

[Install]
WantedBy=multi-user.target
